<section class="pillars" aria-labelledby="pillars-title-{{ section.id }}">
  <div class="container">
    <h2 id="pillars-title-{{ section.id }}">{{ section.settings.heading }}</h2>
    <div class="pillars__grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <article class="pillar" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            {% if block.settings.body != blank %}
              <p>{{ block.settings.body }}</p>
            {% endif %}
            {% if block.settings.link_label != blank and block.settings.link != blank %}
              <a class="link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
            {% endif %}
          </article>
        {% endfor %}
      {% else %}
        <article class="pillar">
          <h3>Curated Shopping</h3>
          <p>Discover limited-run drops, bespoke creations, and ritual kits that channel your glow. Every product is intentionally sourced and ethically crafted.</p>
          <a class="link" href="/collections/all">Shop the latest</a>
        </article>
        <article class="pillar">
          <h3>Members-Only Accounts</h3>
          <p>Unlock rewards, track your journey, and access private lounges with a membership account tuned to your inner alchemy.</p>
          <a class="link" href="/account/register">Create your account</a>
        </article>
        <article class="pillar">
          <h3>Storytelling &amp; Community</h3>
          <p>Stay inspired with blog features, astrology notes, and behind-the-flame exclusives from the Shaicandie collective.</p>
          <a class="link" href="/blogs/news">Browse the blog</a>
        </article>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pillars",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for your soft & savage rituals"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Curated Shopping"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Discover limited-run drops, bespoke creations, and ritual kits that channel your glow. Every product is intentionally sourced and ethically crafted."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop the latest"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": "/collections/all"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Pillars",
      "blocks": [
        {
          "type": "pillar"
        },
        {
          "type": "pillar"
        },
        {
          "type": "pillar"
        }
      ]
    }
  ]
}
{% endschema %}
