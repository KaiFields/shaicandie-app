<section class="hero" id="hero" aria-labelledby="hero-title-{{ section.id }}">
  <div class="container hero__inner">
    <div class="hero__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h1 id="hero-title-{{ section.id }}">{{ section.settings.heading }}</h1>
      {% if section.settings.body != blank %}
        <p>{{ section.settings.body }}</p>
      {% endif %}
      <div class="hero__actions">
        {% if section.settings.primary_label != blank %}
          <a class="btn btn--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a class="btn btn--ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
        {% endif %}
      </div>
    </div>
    <div class="hero__visual" role="presentation">
      <div class="hero__flame">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_alt }}
        {% else %}
          <img src="{{ 'hero-illustration.svg' | asset_url }}" alt="" loading="lazy">
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Shaicandie Rebirth Lounge"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Soft hues. Savage energy. Rebirth begins here."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Immerse yourself in a cosmic sanctuary that embraces both your velvet heart and your fierce ambition. From luxurious self-care rituals to unapologetic statement pieces, we curate everything you need to glow differently."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Explore the Collection"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Join the Lounge"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link",
      "default": "/account/register"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Hero image alt text"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
