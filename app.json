    "name": "Soft But Savage",
    "slug": "shaicandie-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "scheme": "shaicandie",
    "assetBundlePatterns": ["**/*"],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "authApiUrl": "${AUTH_API_URL}",
      "mentorApiUrl": "${MENTOR_API_URL}",
      "videoHostUrl": "${VIDEO_PROVIDER_URL}",
      "commerceUrl": "${COMMERCE_URL}",
      "sentryDsn": "${SENTRY_DSN}"
    }
  }
}
